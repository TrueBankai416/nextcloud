# =============================================================================
# NEXTCLOUD ENHANCED DOCKER-COMPOSE CONFIGURATION
# =============================================================================
# Copy this file to .env and customize the values below
# All values have secure defaults - change passwords for production use!

# =============================================================================
# NEXTCLOUD CONFIGURATION
# =============================================================================
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=change_me_secure_password

# Domain Configuration (space-separated list)
NEXTCLOUD_TRUSTED_DOMAINS=localhost nextcloud.local your-domain.com

# Primary domain for Nextcloud (used for Collabora integration)
NEXTCLOUD_DOMAIN=localhost

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=nextcloud
MYSQL_USER=nextcloud
MYSQL_PASSWORD=change_me_db_password

# =============================================================================
# PERFORMANCE CONFIGURATION
# =============================================================================
PHP_MEMORY_LIMIT=1024M
PHP_UPLOAD_LIMIT=2048M

# =============================================================================
# NETWORK CONFIGURATION
# =============================================================================
# Main Nextcloud HTTP port
HTTP_PORT=8080

# notify_push WebSocket port
NOTIFY_PUSH_PORT=7867

# Nginx reverse proxy ports (when using with-nginx profile)
HTTP_PORT_NGINX=80
HTTPS_PORT=443
NGINX_HOST=localhost

# Internal nginx port for external proxy integration (like AIO port 11000)
NGINX_INTERNAL_PORT=11000

# =============================================================================
# COLLABORA ONLINE CONFIGURATION (with-collabora profile)
# =============================================================================
COLLABORA_PORT=9980
COLLABORA_DOMAIN=nextcloud\\.local
COLLABORA_USERNAME=admin
COLLABORA_PASSWORD=change_me_collabora_password

# =============================================================================
# ONLYOFFICE CONFIGURATION (with-onlyoffice profile)
# =============================================================================
ONLYOFFICE_PORT=8000
ONLYOFFICE_JWT_SECRET=change_me_jwt_secret

# =============================================================================
# BACKUP CONFIGURATION (with-backup profile)
# =============================================================================
# Backup schedule (cron format) - default: 2 AM daily
BACKUP_CRON_EXPRESSION=0 2 * * *
BACKUP_RETENTION_DAYS=7

# =============================================================================
# ADVANCED CONFIGURATION
# =============================================================================
# Uncomment and customize these if needed

# Custom network subnet (default: 172.20.0.0/16)
# DOCKER_NETWORK_SUBNET=172.20.0.0/16

# Custom volume paths (leave empty to use Docker volumes)
# NEXTCLOUD_DATA_PATH=./nextcloud_data
# DB_DATA_PATH=./db_data
# REDIS_DATA_PATH=./redis_data

# SSL Certificate paths (for nginx with HTTPS)
# SSL_CERT_PATH=./ssl/cert.pem
# SSL_KEY_PATH=./ssl/key.pem

# =============================================================================
# USAGE EXAMPLES
# =============================================================================
# Basic setup:
#   docker-compose up -d
#
# With internal nginx (for external proxy integration):
#   docker-compose --profile with-nginx up -d
#
# With direct external nginx (no external proxy):
#   docker-compose --profile with-nginx-external up -d
#
# With Collabora document editing:
#   docker-compose --profile with-collabora up -d
#
# With OnlyOffice document editing:
#   docker-compose --profile with-onlyoffice up -d
#
# With automated backups:
#   docker-compose --profile with-backup up -d
#
# Full setup with internal nginx and external proxy:
#   docker-compose --profile with-nginx --profile with-collabora --profile with-backup up -d
#
# Full setup with direct external access:
#   docker-compose --profile with-nginx-external --profile with-collabora --profile with-backup up -d
